# Environment variants are local; keep bare .env and sample templates trackable.
**/.env.*
!**/.env.example
.agents 
# JavaScript and Expo
**/node_modules/
**/.expo/
**/web-build/
**/dist/
**/coverage/
**/.cache/
**/.turbo/
**/*.tsbuildinfo

# Flutter and Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/.symlinks/
**/ios/Pods/
**/Flutter/ephemeral/

# Android and Gradle local output
**/.gradle/
**/local.properties

# Logs and temporary files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
**/*.tmp

# Native signing material
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.mobileprovision

# Editors and operating systems
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
